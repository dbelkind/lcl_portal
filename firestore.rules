rules_version = '2';

// These rules are what keep schedules private. The site's code runs in people's browsers and can't enforce anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(email());
    }
    function isMember() {
      return verified() && exists(memberPath());
    }
    // Lab managers, and the PI while they've turned on Lab Management Mode. Matches actsAsLabManager in scheduling.js.
    function isReviewer() {
      return isMember() && (get(memberPath()).data.role == 'reviewer'
        || (get(memberPath()).data.role == 'pi' && get(memberPath()).data.get('labManagement', false) == true));
    }
    // PhD Students, Post-Docs and the PI change their own entries and approve their own time off without review.
    function isGrad() {
      return isMember() && get(memberPath()).data.role in ['grad', 'pi'];
    }
    // Anyone with the Booking responsibility can book participants into visits.
    function isBooker() {
      return isMember() && get(memberPath()).data.get('skills', []).hasAny(['Booking']);
    }
    // Matches titleOf in scheduling.js: each role is also a place in the lab directory.
    function titleFor(member) {
      return member.role == 'pi' ? 'PI' : (member.role == 'reviewer' ? 'Lab Manager'
        : (member.role == 'grad' ? (member.get('title', '') == 'Post-Doc' ? 'Post-Doc' : 'PhD Student') : 'RA'));
    }
    function emailKinds() {
      return ['requests', 'updates', 'bookings', 'cancellations', 'scanReminders', 'celebrations', 'missingSchedules', 'websiteUpdates'];
    }
    function owns(data) {
      return isMember() && data.ownerEmail == email();
    }
    function shortNote(data) {
      return !('note' in data) || (data.note is string && data.note.size() <= 100);
    }
    function validAvailability(data) {
      return data.keys().hasAll(['ownerEmail', 'type', 'days', 'start', 'end', 'from'])
        && data.keys().hasOnly(['ownerEmail', 'type', 'days', 'start', 'end', 'from', 'to', 'semester', 'note'])
        && data.type in ['class', 'conflict']
        && data.days is list && data.days.size() > 0
        && data.start is string && data.end is string && data.start < data.end
        && data.from is string
        && (!('to' in data) || (data.to is string && data.from <= data.to))
        && (data.type != 'conflict' || ('note' in data && data.note is string && data.note.size() > 0))
        && shortNote(data);
    }
    // Members can only ever submit a request as pending, so approving is left to reviewers.
    // A request with times covers part of a single day.
    function validRequest(data) {
      return data.keys().hasAll(['ownerEmail', 'from', 'to', 'status', 'note'])
        && data.note is string && data.note.size() > 0
        && data.keys().hasOnly(['ownerEmail', 'from', 'to', 'start', 'end', 'note', 'status'])
        && data.status == 'pending'
        && data.from is string && data.to is string && data.from <= data.to
        && (!('start' in data) || (data.start is string && data.end is string && data.start < data.end && data.from == data.to))
        && shortNote(data);
    }
    // A reviewer entering time off for a lab member saves it already approved, signed with their own email.
    function validEnteredByReviewer(data) {
      return data.keys().hasAll(['ownerEmail', 'from', 'to', 'status', 'reviewedBy', 'reviewedAt'])
        && data.keys().hasOnly(['ownerEmail', 'from', 'to', 'start', 'end', 'note', 'status', 'reviewedBy', 'reviewedAt'])
        && data.ownerEmail is string
        && data.status == 'approved'
        && data.reviewedBy == email()
        && data.from is string && data.to is string && data.from <= data.to
        && (!('start' in data) || (data.start is string && data.end is string && data.start < data.end && data.from == data.to))
        && shortNote(data);
    }
    function validSelfApproved(data) {
      return data.keys().hasAll(['ownerEmail', 'from', 'to', 'status', 'reviewedBy', 'reviewedAt', 'note'])
        && data.keys().hasOnly(['ownerEmail', 'from', 'to', 'start', 'end', 'note', 'status', 'reviewedBy', 'reviewedAt'])
        && data.status == 'approved'
        && data.reviewedBy == email()
        && data.note is string && data.note.size() > 0
        && data.from is string && data.to is string && data.from <= data.to
        && (!('start' in data) || (data.start is string && data.end is string && data.start < data.end && data.from == data.to))
        && shortNote(data);
    }
    function validDecision() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
        && data.status in ['approved', 'declined']
        && data.reviewedBy == email()
        && (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 200));
    }

    // Everyone in the lab can look up the reviewers: bookers email them a booking's participant details, and the site
    // shows who's emailed about what someone does.
    match /members/{memberEmail} {
      allow get: if verified() && (memberEmail == email() || isReviewer() || (isMember() && resource.data.role in ['reviewer', 'pi']));
      allow list: if isReviewer() || (isMember() && resource.data.role in ['reviewer', 'pi']);
      allow create, update: if isReviewer()
        && memberEmail == memberEmail.lower()
        && request.resource.data.keys().hasOnly(['name', 'role', 'skills', 'notify', 'emails', 'title', 'labManagement'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.role in ['member', 'ra', 'grad', 'reviewer', 'pi']
        && (!('labManagement' in request.resource.data) || request.resource.data.labManagement is bool)
        && (!('skills' in request.resource.data)
          || (request.resource.data.skills is list && request.resource.data.skills.size() <= 10))
        && (!('notify' in request.resource.data) || request.resource.data.notify is bool)
        && (!('title' in request.resource.data) || request.resource.data.title in ['RA', 'PhD Student', 'Post-Doc', 'Lab Manager', 'PI'])
        && (!('emails' in request.resource.data) || (request.resource.data.emails is map
          && request.resource.data.emails.keys().hasOnly(emailKinds())));
      // The PI turns Lab Management Mode, and its emails, on and off for themself.
      allow update: if memberEmail == email() && isMember() && resource.data.role == 'pi'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['labManagement', 'emails'])
        && (!('labManagement' in request.resource.data) || request.resource.data.labManagement is bool)
        && (!('emails' in request.resource.data) || (request.resource.data.emails is map
          && request.resource.data.emails.keys().hasOnly(emailKinds())));
      allow delete: if isReviewer() && memberEmail != email();
    }

    // A person's own directory entry: a phone number and a last name.
    function validDirectoryOwn(data) {
      return (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 60));
    }

    // The lab directory: everyone in the lab can see each other's name, directory role and phone number.
    // Lab managers keep names and roles in step with the lab list; people add and change their own phone number.
    match /directory/{memberEmail} {
      allow read: if isMember();
      allow create, update: if isReviewer()
        && request.resource.data.keys().hasOnly(['name', 'title', 'phone', 'lastName'])
        && request.resource.data.name is string
        && request.resource.data.title in ['RA', 'PhD Student', 'Post-Doc', 'Lab Manager', 'PI']
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30));
      allow create: if memberEmail == email() && isMember()
        && request.resource.data.keys().hasOnly(['name', 'title', 'phone', 'lastName'])
        && request.resource.data.name == get(memberPath()).data.name
        && request.resource.data.title == titleFor(get(memberPath()).data)
        && validDirectoryOwn(request.resource.data);
      allow update: if memberEmail == email() && isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'lastName'])
        && validDirectoryOwn(request.resource.data);
      allow delete: if isReviewer();
    }

    // A PI's phone number lives here instead of in the directory, so RAs can't see it.
    match /directoryPrivate/{memberEmail} {
      allow read: if (isMember() && get(memberPath()).data.role in ['grad', 'reviewer', 'pi']) || (verified() && memberEmail == email());
      allow create, update: if (isReviewer() || (memberEmail == email() && isMember()))
        && request.resource.data.keys().hasOnly(['phone'])
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      allow delete: if isReviewer() || (memberEmail == email() && isMember());
    }

    // Birthdays (month and day only), expected graduation and favorites: only the person and lab managers can see
    // them, and only the person can change them.
    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }
    function validProfile(data) {
      return data.keys().hasAll(['birthday', 'graduation', 'color', 'dessert', 'dietary', 'updatedAt'])
        && data.keys().hasOnly(['birthday', 'graduation', 'color', 'dessert', 'dietary', 'updatedAt'])
        && data.birthday is string && data.birthday.matches('^[0-9]{2}-[0-9]{2}$')
        && data.graduation is string && (data.graduation == 'n/a' || data.graduation.matches('^[0-9]{4}-[0-9]{2}$'))
        && shortText(data.color) && shortText(data.dessert) && shortText(data.dietary)
        && data.updatedAt is string;
    }
    match /profiles/{memberEmail} {
      allow read: if verified() && (memberEmail == email() || isReviewer());
      allow create, update: if memberEmail == email() && isMember() && validProfile(request.resource.data);
      allow delete: if isReviewer();
    }

    // Members can add new entries, but changing or removing a saved one goes through a change request,
    // which only a reviewer can apply.
    match /availability/{id} {
      allow read: if owns(resource.data) || isReviewer();
      allow create: if (owns(request.resource.data) || isReviewer()) && validAvailability(request.resource.data);
      allow update: if (isReviewer() || (isGrad() && owns(resource.data) && owns(request.resource.data)))
        && validAvailability(request.resource.data);
      allow delete: if isReviewer() || (isGrad() && owns(resource.data));
    }

    match /changeRequests/{id} {
      allow read: if owns(resource.data) || isReviewer();
      allow create: if owns(request.resource.data)
        && request.resource.data.keys().hasOnly(['ownerEmail', 'status', 'summary', 'plan', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 500
        && request.resource.data.plan is map
        && request.resource.data.plan.keys().hasOnly(['creates', 'updates', 'deletes'])
        && request.resource.data.plan.creates is list && request.resource.data.plan.creates.size() <= 50
        && request.resource.data.plan.updates is list && request.resource.data.plan.updates.size() <= 50
        && request.resource.data.plan.deletes is list && request.resource.data.plan.deletes.size() <= 50;
      allow update: if isReviewer() && validDecision();
      allow delete: if owns(resource.data) || isReviewer();
    }

    // A PhD Student/Post-Doc's change leaves a notice, and so does the PI turning Lab Management Mode on or off; the
    // Apps Script emails the lab managers about it and deletes it.
    match /notices/{id} {
      allow read, delete: if isReviewer();
      allow create: if owns(request.resource.data) && (isGrad() || get(memberPath()).data.role == 'pi')
        && request.resource.data.keys().hasOnly(['ownerEmail', 'kind', 'summary', 'createdAt'])
        && request.resource.data.kind in ['change', 'timeOff', 'labManagement']
        && (request.resource.data.kind != 'labManagement' || get(memberPath()).data.role == 'pi')
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 600
        && request.resource.data.createdAt is string;
    }

    function appointmentKeys() {
      return ['date', 'defaultFor', 'cancelled', 'lab', 'scan', 'booking', 'bookedBy', 'bookedByName', 'bookedAt',
        'requestedStart', 'confirmed', 'confirmedBy', 'confirmedAt'];
    }
    function bookingKeys() {
      return ['booking', 'bookedBy', 'bookedByName', 'bookedAt', 'requestedStart', 'confirmed'];
    }
    // A booker can ask for a start between 8:00 and 10:00 AM, which a reviewer approves when confirming. Booking or
    // cancelling a booking always leaves the visit unconfirmed, so a reviewer confirms each booking.
    function validBookingBy(data) {
      return data.booking in ['booked', 'rebooking']
        && data.bookedBy == email()
        && data.bookedByName is string && data.bookedByName.size() <= 100
        && data.bookedAt is string
        && (!('requestedStart' in data) || data.requestedStart == ''
          || (data.requestedStart is string && data.requestedStart >= '08:00' && data.requestedStart <= '10:00'))
        && data.get('confirmed', false) == false;
    }

    // Visits hold no participant information, only times and whether they're booked and confirmed.
    // Bookers can only book a visit (asking for another start time if needed) or cancel its booking, from the
    // November 5, 2026 visits on. Only reviewers confirm bookings and change visit times.
    match /appointments/{id} {
      // Everyone in the lab sees the Lab Calendar's open slots and scheduled visits; staffing is kept separately.
      allow read: if isMember();
      allow create, update: if isReviewer()
        && request.resource.data.keys().hasOnly(appointmentKeys())
        && request.resource.data.date is string;
      allow create: if isBooker()
        && request.resource.data.keys().hasOnly(appointmentKeys())
        && validBookingBy(request.resource.data)
        && request.resource.data.date is string && request.resource.data.date >= '2026-11-05'
        && id == 'default-' + request.resource.data.date
        && request.resource.data.defaultFor == request.resource.data.date
        && request.resource.data.cancelled == false
        && request.resource.data.lab == {'start': '09:00', 'end': '11:00'}
        && request.resource.data.scan == {'start': '11:00', 'end': '13:00', 'wandingRequired': true};
      allow update: if isBooker()
        && resource.data.cancelled == false
        && resource.data.date >= '2026-11-05'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(bookingKeys())
        && validBookingBy(request.resource.data);
      allow delete: if isReviewer();
    }

    // The USC academic calendar and staff holidays, which lab managers keep up to date under Website management.
    // Everyone in the lab reads them; until they're first saved here, the site uses the files published with it.
    match /settings/{name} {
      allow read: if isMember();
      allow write: if isReviewer()
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt is string
        && ((name == 'academicCalendar'
            && request.resource.data.keys().hasOnly(['semesters', 'events', 'source', 'updatedBy', 'updatedAt'])
            && request.resource.data.semesters is list && request.resource.data.semesters.size() <= 60
            && request.resource.data.events is list && request.resource.data.events.size() <= 600)
          || (name == 'staffHolidays'
            && request.resource.data.keys().hasOnly(['holidays', 'note', 'updatedBy', 'updatedAt'])
            && request.resource.data.holidays is list && request.resource.data.holidays.size() <= 300));
    }

    // Semesters someone has no classes in, so the Apps Script doesn't keep asking for their class schedule.
    match /noClasses/{memberEmail} {
      allow read: if verified() && (memberEmail == email() || isReviewer());
      allow create, update: if ((memberEmail == email() && isMember()) || isReviewer())
        && request.resource.data.keys().hasOnly(['semesters'])
        && request.resource.data.semesters is list && request.resource.data.semesters.size() <= 30;
      allow delete: if (memberEmail == email() && isMember()) || isReviewer();
    }

    // Who is staffing each visit. Only reviewers see it; the Apps Script turns it into calendar events.
    match /staffing/{key} {
      allow read, delete: if isReviewer();
      allow create, update: if isReviewer()
        && request.resource.data.keys().hasOnly(['date', 'visitKey', 'lab', 'scan', 'managers', 'approvedBy', 'approvedAt'])
        && request.resource.data.visitKey == key
        && request.resource.data.date is string
        && request.resource.data.managers is list && request.resource.data.managers.size() <= 3
        && request.resource.data.approvedBy == email();
    }

    // The Staffing calendar's reference slots for a day, when they're changed from the usual ones. Only reviewers.
    match /referenceSlots/{date} {
      allow read, delete: if isReviewer();
      allow create, update: if isReviewer()
        && request.resource.data.keys().hasOnly(['date', 'slots', 'updatedBy'])
        && request.resource.data.date == date
        && request.resource.data.slots is list && request.resource.data.slots.size() <= 12
        && request.resource.data.updatedBy == email();
    }

    // Who to leave off the email about something someone just did, and any message to add. Anyone in the lab saves
    // their own; only reviewers (and the Apps Script) read them.
    match /emailChoices/{id} {
      allow read, delete: if isReviewer();
      // A choice that's still waiting can be replaced by whoever made it, or by a reviewer.
      allow create, update: if isMember()
        && (resource == null || resource.data.by == email() || isReviewer())
        && request.resource.data.keys().hasOnly(['kind', 'ref', 'skip', 'none', 'message', 'by', 'byName', 'createdAt'])
        && request.resource.data.kind in ['requests', 'updates', 'cancellations', 'staff', 'reviewResult']
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 200
        && request.resource.data.skip is list && request.resource.data.skip.size() <= 50
        && request.resource.data.none is bool
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.by == email()
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 100
        && request.resource.data.createdAt is string;
    }

    match /timeOff/{id} {
      allow read: if owns(resource.data) || isReviewer();
      allow create: if (owns(request.resource.data) && validRequest(request.resource.data))
        || (owns(request.resource.data) && isGrad() && validSelfApproved(request.resource.data))
        || (isReviewer() && validEnteredByReviewer(request.resource.data));
      // Replacing a request drops its old decision, so a member's edit always goes back for review.
      allow update: if (owns(resource.data) && owns(request.resource.data) && validRequest(request.resource.data))
        || (owns(resource.data) && owns(request.resource.data) && isGrad() && validSelfApproved(request.resource.data))
        || (isReviewer() && validDecision())
        || (isReviewer() && validEnteredByReviewer(request.resource.data));
      allow delete: if owns(resource.data) || isReviewer();
    }
  }
}
